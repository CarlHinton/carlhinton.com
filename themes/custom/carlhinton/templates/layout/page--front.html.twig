{{ attach_library('carlhinton/front-page') }}

<!-- CARLHINTON FRONT PAGE TEMPLATE ACTIVE -->

<div id="page-wrapper" class="page-wrapper ch-home-wrapper">
  <div id="page" class="ch-home-page">

    <header id="header" class="site-header ch-home-header" role="banner">
      <div class="ch-home-shell ch-home-header__inner">

        <a class="ch-home-brand" href="/">Carl Hinton</a>

        {% if page.primary_menu %}
          <nav class="ch-home-nav" aria-label="{{ 'Main navigation'|t }}">
            {{ page.primary_menu }}
          </nav>
        {% endif %}

      </div>
    </header>

    <div id="main-wrapper" class="layout-main-wrapper ch-home-main-wrapper">
      <div id="main" class="layout-main ch-home-main">

        <div class="main-content">
          <a id="main-content" tabindex="-1"></a>

          <div class="main-content__container ch-home-shell ch-home-container">

            {% if page.highlighted %}
              <div class="ch-home-highlighted">
                {{ page.highlighted }}
              </div>
            {% endif %}

            <main role="main" class="ch-home-content-area">

              {{ page.content }}

            </main>

          </div>
        </div>

      </div>
    </div>

    <div class="overlay" data-drupal-selector="overlay"></div>

  </div>
</div>
