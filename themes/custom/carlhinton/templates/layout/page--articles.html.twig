{#
/**
 * @file
 # CARL HINTON page--articles.html.twig
#}

{{ attach_library('carlhinton/articles-page') }}
<!-- CARLHINTON PAGE ARTICLES TEMPLATE ACTIVE -->

<div id="page-wrapper" class="page-wrapper">
  <div id="page">

    {% if page.header or page.primary_menu %}
  <header id="header" class="ch-articles-header" role="banner">
    <div class="ch-articles-header__inner">

      {% if page.header %}
        <div class="ch-articles-header__brand">
          {{ page.header }}
        </div>
      {% endif %}

      {% if page.primary_menu %}
        <nav class="ch-articles-header__nav" aria-label="{{ 'Main navigation'|t }}">
          {{ page.primary_menu|without(
            'carlhinton_search_form_narrow',
            'carlhinton_search_form_wide',
            'carlhinton_account_menu'
          ) }}
        </nav>
      {% endif %}

    </div>
  </header>
{% endif %}
  

    <div id="main-wrapper" class="layout-main-wrapper layout-container">
      <div id="main" class="layout-main">
        <div class="main-content">
          <a id="main-content" tabindex="-1"></a>

          <section class="ch-articles-hero-panel">
            <div class="ch-articles-hero-panel__inner">

              <nav class="ch-articles-breadcrumb" aria-label="Breadcrumb">
                <a href="/">Home</a>
                <span>/</span>
                <span>Research &amp; Articles</span>
              </nav>

              <h1 class="ch-articles-hero-title">Articles &amp; Research</h1>

              <p class="ch-articles-hero-intro">
                Insights, analysis and perspectives on technology leadership, infrastructure
                resilience, systems thinking and the future of our digital world.
              </p>

              <div class="ch-articles-feature-strip" aria-label="Article section highlights">

                <div class="ch-articles-feature-strip__item">
                  <span class="ch-feature-icon" aria-hidden="true">▣</span>
                  <div>
                    <strong>Regular insights</strong>
                    <small>Fresh thinking on technology and systems</small>
                  </div>
                </div>

                <div class="ch-articles-feature-strip__item">
                  <span class="ch-feature-icon" aria-hidden="true">▤</span>
                  <div>
                    <strong>In-depth research</strong>
                    <small>Detailed analysis and practical frameworks</small>
                  </div>
                </div>

                <div class="ch-articles-feature-strip__item">
                  <span class="ch-feature-icon" aria-hidden="true">◎</span>
                  <div>
                    <strong>Real-world experience</strong>
                    <small>Lessons from decades of delivery</small>
                  </div>
                </div>

                <div class="ch-articles-feature-strip__item">
                  <span class="ch-feature-icon" aria-hidden="true">◇</span>
                  <div>
                    <strong>Future focused</strong>
                    <small>Exploring emerging trends and challenges</small>
                  </div>
                </div>

              </div>

            </div>
          </section>

          {{ page.hero }}
          <div class="main-content__container container">
            {{ page.highlighted }}
            {{ page.breadcrumb }}

            {% if page.sidebar %}
              <div class="sidebar-grid grid-full">
                <main role="main" class="site-main">
                  {{ page.content_above }}
                  {{ page.content }}
                </main>

                {{ page.sidebar }}
              </div>
            {% else %}
              <main role="main">
                {{ page.content_above }}
                {{ page.content }}
              </main>
            {% endif %}
            {{ page.content_below }}
          </div>
        </div>
        <div class="social-bar">
          {{ page.social }}
        </div>
      </div>
    </div>

    <footer class="site-footer">
      <div class="site-footer__inner container">
        {{ page.footer_top }}
        {{ page.footer_bottom }}
      </div>
    </footer>

    <div class="overlay" data-drupal-selector="overlay"></div>

  </div>
</div>
