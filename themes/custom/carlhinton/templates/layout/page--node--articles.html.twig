{#
/**
 * @file
 * Custom page wrapper for Articles content type node pages.
 *
 * Content type machine name:
 * articles
 *
 * Purpose:
 * - Keep Drupal-managed branding and primary menu.
 * - Avoid Olivero header/search JS on article node pages.
 * - Do not hard-code menu links.
 * - Let node--articles--full.html.twig control the article page design.
 */
#}

<!-- CARLHINTON ARTICLE NODE PAGE TEMPLATE ACTIVE -->

<div id="page-wrapper" class="page-wrapper ch-article-node-page-wrapper">
  <div id="page">

    {% if page.header or page.primary_menu %}
      <header id="header" class="ch-articles-header" role="banner">
        <div class="ch-articles-header__inner">

          {% if page.header %}
            <div class="ch-articles-header__brand">
              {{ page.header }}
            </div>
          {% endif %}

          {% if page.primary_menu %}
            <nav class="ch-articles-header__nav" aria-label="{{ 'Main navigation'|t }}">
              {{ page.primary_menu|without(
                'carlhinton_search_form_narrow',
                'carlhinton_search_form_wide',
                'carlhinton_account_menu'
              ) }}
            </nav>
          {% endif %}

        </div>
      </header>
    {% endif %}

    <div id="main-wrapper" class="ch-article-node-main-wrapper">
      <div id="main" class="ch-article-node-layout">
        <div class="ch-article-node-main-content">

          <a id="main-content" tabindex="-1"></a>

          {% if page.highlighted %}
            <div class="ch-article-node-admin-region">
              {{ page.highlighted }}
            </div>
          {% endif %}

          <main role="main" class="ch-article-node-main">
            {{ page.content }}
          </main>

        </div>

        {% if page.social %}
          <div class="social-bar">
            {{ page.social }}
          </div>
        {% endif %}

      </div>
    </div>

    {% if page.footer_top or page.footer_bottom %}
      <footer class="site-footer">
        <div class="site-footer__inner container">

          {% if page.footer_top %}
            {{ page.footer_top }}
          {% endif %}

          {% if page.footer_bottom %}
            {{ page.footer_bottom }}
          {% endif %}

        </div>
      </footer>
    {% endif %}

  </div>
</div>
