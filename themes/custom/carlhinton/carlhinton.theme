<?php

/**
 * Implements hook_preprocess_page().
 */
function carlhinton_preprocess_page(array &$variables): void {
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['#attached']['library'][] = 'carlhinton/home-page';
  }
}
/**
 * Implements hook_theme_suggestions_page_alter().
 */
function carlhinton_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');

  if ($node instanceof \Drupal\node\NodeInterface && $node->bundle() === 'articles') {
    $suggestions[] = 'page__node__articles';
  }
}
